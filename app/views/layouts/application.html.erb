<!DOCTYPE html>
<html>
  <head>
    <title>TarefaPlus</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>

    <% if Rails.env.development? %>
      <%= stylesheet_link_tag "xray", "data-turbo-track": "reload" %>
    <% end %>
  </head>

  <body>
    <%= yield %>

    <%= javascript_importmap_tags %>


    <% if Rails.env.development? %>
      <%= javascript_include_tag "jquery3", "data-turbo-track": "reload" %>
      <%= javascript_include_tag "xray", "data-turbo-track": "reload", defer: true %>
    <% end %>

  </body>
</html>
